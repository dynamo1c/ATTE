# Copy to .env and adjust. .env is never committed.
DATABASE_URL=postgres://mei:mei_dev_password@localhost:5433/mei_attendance

# Seed: last date to generate attendance for (YYYY-MM-DD). Empty = today (Asia/Kolkata).
SEED_UNTIL=

# Seed: password given to every dummy staff account (demo only).
SEED_STAFF_PASSWORD=meidemo2026

# Parent messages. mock = nothing leaves the server (default). whatsapp = Meta WhatsApp Cloud API.
NOTIFY_PROVIDER=mock
# Test mode: only these numbers (comma separated, +91…) receive real messages; others are skipped.
NOTIFY_ALLOWED_NUMBERS=
# Mock only: numbers to treat as "not on WhatsApp" (to see the SMS fallback).
MOCK_NOT_ON_WHATSAPP=
# WhatsApp Cloud API (Meta developer app → WhatsApp → API setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Parent portal demo: with NOTIFY_PROVIDER=mock, show the login code on screen in a production build too (development always shows it).
# Never set this with real student data.
PARENT_OTP_DEMO=
# Laptop demo only: lets sign-in work when phones open the app over plain http on Wi-Fi (http://192.168.x.x:3000).
# Leave empty on any real server: there the app must run behind HTTPS and sign-in cookies stay HTTPS-only.
ALLOW_HTTP_COOKIES=
# Public address of this app, used for links in messages (e.g. https://attendance.meipoly.example). Empty = no link.
PUBLIC_BASE_URL=

# --- Running for real -------------------------------------------------------
# Reverse proxies in front of the app (Caddy / nginx / IIS). Used to read the visitor's real IP for rate limits.
TRUSTED_PROXY_HOPS=1
# Staff are signed out after this many hours without use.
SESSION_IDLE_HOURS=72
# Database: connections per app process, and the longest a single query may run.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=60000
# Backups (npm run db:backup): where to write, how many to keep, and an off-machine copy (synced folder / USB disk).
BACKUP_DIR=backups
BACKUP_KEEP=30
BACKUP_COPY_DIR=
