# Copy to .env and adjust. .env is never committed.
DATABASE_URL=postgres://mei:mei_dev_password@localhost:5433/mei_attendance

# Seed: last date to generate attendance for (YYYY-MM-DD). Empty = today (Asia/Kolkata).
SEED_UNTIL=

# Seed: password given to every dummy staff account (demo only).
SEED_STAFF_PASSWORD=meidemo2026

# Parent messages. mock = nothing leaves the server (default). whatsapp = Meta WhatsApp Cloud API.
NOTIFY_PROVIDER=mock
# Test mode: only these numbers (comma separated, +91…) receive real messages; others are skipped.
NOTIFY_ALLOWED_NUMBERS=
# Mock only: numbers to treat as "not on WhatsApp" (to see the SMS fallback).
MOCK_NOT_ON_WHATSAPP=
# WhatsApp Cloud API (Meta developer app → WhatsApp → API setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Public address of this app, used for links in messages (e.g. https://attendance.meipoly.example). Empty = no link.
PUBLIC_BASE_URL=
